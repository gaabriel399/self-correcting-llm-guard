{
  "self-correcting-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ../scripts/antigravity_guard_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ../scripts/antigravity_guard_hook.py"
      }
    ]
  }
}
